  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "B\u1EA1n ti\u1EBFn l\u1EA1i, ng\u1ED3i l\xEAn Ngai V\xE0ng L\u1EE5i T\xE0n.\nK\u1EBFt
    qu\u1EA3: \xC1nh l\u1EEDa l\u1EE5i d\u1EA7n, v\xE0 b\u1EA1n c\u1EA3m nh\u1EADn
    g\xE1nh n\u1EB7ng c\u1EE7a h\xE0ng ng\xE0n k\xFD \u1EE9c tr\xFAt xu\u1ED1ng vai.\nB\u1EA1n
    tr\u1EDF th\xE0nh Vua G\u1EE5c Ng\xE3 m\u1EDBi \u2014 k\u1EBB canh gi\u1EEF L\xE2u
    \u0110\xE0i U T\xE0n, ng\u01B0\u1EDDi b\u1EA3o t\u1ED3n v\xF2ng l\u1EB7p \u0111\u1EC3
    th\u1EBF gi\u1EDBi kh\xF4ng s\u1EE5p \u0111\u1ED5 v\xE0o h\u01B0 v\xF4.\n\u1EDE
    \u0111\xE2u \u0111\xF3, m\u1ED9t Ti\u1EBFng Vang kh\xE1c s\u1EBD l\u1EA1i \u0111\u01B0\u1EE3c
    \u0111\xE1nh th\u1EE9c, b\u01B0\u1EDBc v\xE0o h\xE0nh tr\xECnh y h\u1EC7t b\u1EA1n.\n\n\u201CL\u1EDDi
    nguy\u1EC1n v\u1EABn ti\u1EBFp t\u1EE5c\u2026 Ai \u0111\xF3, xin h\xE3y c\u1EE9u
    ch\xFAng t\xF4i\u2026\u201D"
