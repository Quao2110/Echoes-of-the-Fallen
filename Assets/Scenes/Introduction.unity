--- !u!114 &2124282664
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2124282662}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Th\u1EBF gi\u1EDBi t\u1EEBng r\u1EF1c r\u1EE1 \xE1nh s\xE1ng, nh\u01B0ng
    gi\u1EDD ch\u1EC9 c\xF2n l\u1EA1i L\xE2u \u0110\xE0i U T\xE0n \u2014 n\u01A1i
    th\u1EDDi gian b\u1ECB phong \u1EA5n, v\xE0 m\u1ECDi linh h\u1ED3n \u0111\u1EC1u
    m\u1EAFc k\u1EB9t trong v\xF2ng l\u1EB7p c\u1EE7a c\xE1i ch\u1EBFt.\n\nB\u1EA1n
    t\u1EC9nh d\u1EADy trong \u0111\u1ED1ng tro t\xE0n, kh\xF4ng nh\u1EDB m\xECnh
    l\xE0 ai, ch\u1EC9 bi\u1EBFt r\u1EB1ng m\xECnh \u0111\u01B0\u1EE3c g\u1ECDi l\xE0
    K\u1EBB L\xE3ng Qu\xEAn. B\u1EA1n kh\xF4ng th\u1EF1c s\u1EF1 s\u1ED1ng \u2014
    b\u1EA1n ch\u1EC9 l\xE0 m\u1ED9t Ti\u1EBFng Vang (Echo), m\u1ED9t k\xFD \u1EE9c
    b\u1ECB r\xE0ng bu\u1ED9c v\xE0o th\u1EBF gi\u1EDBi n\xE0y.\n\nM\u1ED7i khi b\u1EA1n
    g\u1EE5c ng\xE3, \u0110\u1ED1m L\u1EEDa An T\u1ECDa (Bonfire) l\u1EA1i k\xE9o
    b\u1EA1n tr\u1EDF v\u1EC1, t\xE1i t\u1EA1o b\u1EA1n t\u1EEB m\u1EA3nh v\u1EE5n
    k\xFD \u1EE9c. Nh\u01B0ng c\xF9ng v\u1EDBi s\u1EF1 h\u1ED3i sinh c\u1EE7a b\u1EA1n,
    m\u1ECDi th\u1EE9 xung quanh \u2014 qu\xE1i v\u1EADt, linh h\u1ED3n, chi\u1EBFn
    binh \u2014 c\u0169ng s\u1ED1ng l\u1EA1i. Kh\xF4ng ai \u0111\u01B0\u1EE3c ph\xE9p
    tho\xE1t kh\u1ECFi s\u1EF1 l\u1EB7p l\u1EA1i \u1EA5y.\n\nTr\xEAn h\xE0nh tr\xECnh
    \u0111i s\xE2u v\xE0o l\xF2ng L\xE2u \u0110\xE0i, b\u1EA1n kh\xE1m ph\xE1 ra
    s\u1EF1 th\u1EADt: t\u1EA5t c\u1EA3 \u0111\u1EC1u b\u1ECB tr\xF3i bu\u1ED9c b\u1EDFi
    L\u1EDDi Nguy\u1EC1n C\u1EE7a Vua G\u1EE5c Ng\xE3, m\u1ED9t k\u1EBB t\u1EEBng
    c\u1ED1 c\u1EE9u l\u1EA5y th\u1EBF gi\u1EDBi nh\u01B0ng l\u1EA1i b\u1ECB ch\xEDnh
    k\xFD \u1EE9c c\u1EE7a m\xECnh nu\u1ED1t ch\u1EEDng.\n\nV\xE0 r\u1ED3i, khi b\u1EA1n
    \u0111\u1ED1i m\u1EB7t v\u1EDBi h\u1EAFn \u2014 k\u1EBB ph\u1EA3n chi\u1EBFu
    ch\xEDnh m\xECnh \u2014 b\u1EA1n nh\u1EADn ra r\u1EB1ng k\u1EBFt th\xFAc th\u1EF1c
    s\u1EF1 ch\u01B0a bao gi\u1EDD t\u1ED3n t\u1EA1i.\nCh\u1EC9 c\xF3 l\u1EF1a ch\u1ECDn:
    ph\xE1 v\u1EE1 v\xF2ng l\u1EB7p, hay ti\u1EBFp t\u1EE5c duy tr\xEC n\xF3.\nB\u1EDFi
    trong L\xE2u \u0110\xE0i U T\xE0n, ngay c\u1EA3 s\u1EF1 qu\xEAn l\xE3ng\u2026
    c\u0169ng kh\xF4ng th\u1EC3 \u0111\u01B0\u1EE3c qu\xEAn."
